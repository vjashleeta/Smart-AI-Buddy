    Start --> Entry --> AuthChoice
    AuthChoice -->|"Sign in"| Login
    AuthChoice -->|"Register"| Register
    AuthChoice -->|"Recover password"| Recover
    Register -->|"Save account and send verification email"| Verify
    Verify -->|"Verified"| Login
    Recover -->|"Send reset link by email"| Reset
    Reset --> Login
    Login --> Authenticate --> LoginOK
    LoginOK -->|"No"| LoginError --> Login
    LoginOK -->|"Yes"| Session --> Dashboard --> Features
    Features --> Chat
    Features --> Tutor
    Features --> Planner
    Features --> Quiz
    Features --> Resources
    Features --> Analytics
    Features --> Settings
    Chat --> APIs
    Tutor --> APIs
    Planner --> APIs
    Quiz --> APIs
    Resources --> APIs
    Analytics --> APIs
    Settings --> APIs
    APIs --> Data
    Data -->|"Yes when required"| Database
    Data -->|"No"| External
    Database --> External
    External -->|"Yes when required"| Services
    External -->|"No"| Result
    Services --> Result
    Result --> Continue
    Continue -->|"Yes"| Features
    Continue -->|"No, log out"| Logout --> LoggedOut --> Exit

