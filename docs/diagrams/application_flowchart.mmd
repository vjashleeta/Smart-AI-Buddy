    Features{"Choose a feature"}
    Chat["AI Buddy chat"]
    Tutor["Socratic Tutor"]
    Planner["Study planner"]
    Quiz["Quiz and study materials"]
    Resources["Resources and PDF upload"]
    Analytics["Dashboard and performance"]
    Settings["Profile and password settings"]
    APIs["Feature controller and service"]
    Data{"Does this feature use stored data?"}
    Database[("MySQL through JPA and Hibernate")]
    External{"Does this feature need an external or PDF service?"}
    Services["Gemini API, SMTP, or PDFBox as applicable"]
    Result["Return result to browser and display"]
    Continue{"Continue using the application?"}
    Logout["POST logout and invalidate session"]
